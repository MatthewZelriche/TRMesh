<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>tr_mesh</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
    <Compile Remove="generators/**" />
    <EmbeddedResource Remove="generators/**" />
    <None Remove="generators/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="tr-mesh.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="generators\tr-mesh.Generators\tr-mesh.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Opt-in for scripts/run-metrics.ps1 (-p:MetricsScope=true). -->
  <ItemGroup Condition="'$(MetricsScope)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
